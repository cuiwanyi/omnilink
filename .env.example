# ================= LLM 配置（云端 OpenAI 兼容 API） =================
# 支持：通义千问（阿里云百炼）/ DeepSeek / OpenAI 等任意 OpenAI 兼容端点
# 示例（通义千问）：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 示例（DeepSeek）：LLM_BASE_URL=https://api.deepseek.com/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-plus
# 任务分解/对齐判断的温度，低温度保证结构化输出稳定
LLM_TEMPERATURE=0.1
# 未配置有效 API Key 时，系统自动降级为规则引擎（演示/测试用）
LLM_FALLBACK_TO_RULES=true

# ================= Redis 配置 =================
# 本地开发默认 fakeredis（进程内存），生产填真实地址如 redis://localhost:6379/0
REDIS_URL=fakeredis://local/0

# ================= 存储配置 =================
# 本地默认 SQLite，生产可切 MySQL（SQLAlchemy URL）
DATABASE_URL=sqlite+aiosqlite:///./omnilink.db

# ================= 服务端口 =================
# 四个平台 Mock API 端口
MOCK_TAOBAO_PORT=9001
MOCK_JD_PORT=9002
MOCK_AMAZON_PORT=9003
MOCK_SHOPIFY_PORT=9004
# 四个平台 MCP Server 端口
MCP_TAOBAO_PORT=9101
MCP_JD_PORT=9102
MCP_AMAZON_PORT=9103
MCP_SHOPIFY_PORT=9104
# 四个平台 A2A Agent 端口
A2A_TAOBAO_PORT=9201
A2A_JD_PORT=9202
A2A_AMAZON_PORT=9203
A2A_SHOPIFY_PORT=9204
# Orchestrator 商家工作台 API 端口
API_PORT=8000

# ================= 模拟故障注入（演示容错能力用） =================
# Amazon 限流概率（0~1），演示指数退避重试
MOCK_AMAZON_RATE_LIMIT_PROB=0.0
# 各平台 API 模拟延迟毫秒
MOCK_LATENCY_MS=200

# ================= 库存与缓存策略 =================
PRICE_CACHE_TTL_SECONDS=60      # 价格缓存 60s
INVENTORY_CACHE_TTL_SECONDS=5   # 库存缓存 5s
PRODUCT_CACHE_TTL_SECONDS=86400 # 商品静态信息 24h
IDEMPOTENCY_WINDOW_SECONDS=300  # 幂等键时间窗 5 分钟
